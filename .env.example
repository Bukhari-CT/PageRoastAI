# ─────────────────────────────────────────────────────────────────────────────
# PageRoastAI — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# Variables under "Application" are validated at startup by shared/config/env.ts
# and the app will not boot (or build) without the required ones.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# MySQL connection string. Percent-encode special characters in the password
# (e.g. "#" -> %23) so it doesn't get misparsed as a URL fragment.
DATABASE_URL="mysql://user:password@localhost:3306/pageroast"

# TypeORM: auto-create schema from entities. Local development only —
# migrations replace this before any production deployment.
DB_SYNCHRONIZE="true"
DB_LOGGING="false"

# ── Auth (required) ──────────────────────────────────────────────────────────
# Random 32-char secret (openssl rand -base64 32)
BETTER_AUTH_SECRET="your_32_char_secret_here"

# Full base URL, e.g. http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Leave both blank to disable Google sign-in. When blank the provider is not
# registered and the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini (required for audits) ─────────────────────────────────────────────
# Optional at boot so unrelated pages still build, but the roast pipeline
# returns a clear error until it is set.
GEMINI_API_KEY=
# Optional: override the default model per tier (defaults shown below)
GEMINI_FREE_MODEL=gemini-flash-lite-latest
# Note: Pro-tier models return HTTP 429 (limit: 0) on the free API tier as of
# testing — gemini-3.6-flash is the strongest model confirmed to work for free.
GEMINI_PREMIUM_MODEL=gemini-3.6-flash

# ── Email / SMTP (required) ──────────────────────────────────────────────────
# Used for email verification and password reset. Signup fails if these are
# wrong, because verification is mandatory.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@example.com"

# ── Application (required) ───────────────────────────────────────────────────
# Same as BETTER_AUTH_URL, but also exposed to the browser. Must be set per
# environment (production, preview, development) or auth callbacks will break.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Seed-only — read by `npm run seed:admin` (bin/SeedAdmin.ts), NOT by the app.
# These do not need to exist in a deployed environment.
# ─────────────────────────────────────────────────────────────────────────────

# Connection string that bypasses a connection pooler, if you use one.
# Falls back to DATABASE_URL when unset.
DIRECT_URL="mysql://user:password@localhost:3306/pageroast"

# The one administrator account the seed script creates. Must be at least 12
# characters; the script refuses to run with the placeholder value below.
ADMIN_EMAIL=admin@pageroast.ai
ADMIN_PASSWORD=change-me-locally

# Set to "true" only to deliberately allow seeding while NODE_ENV=production.
# ALLOW_PRODUCTION_SEED=
