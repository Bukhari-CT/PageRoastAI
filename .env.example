# Supabase pooled connection string (pgbouncer, port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection string (port 5432, for migrations)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Random 32-char secret (openssl rand -base64 32)
BETTER_AUTH_SECRET="your_32_char_secret_here"

# Full base URL e.g. http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="noreply@example.com"

# Admin Credentials
ADMIN_EMAIL=admin@pageroast.ai
ADMIN_PASSWORD=change-me-locally

# Same as BETTER_AUTH_URL but for client-side use
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Keys (Optional for non-monetized environments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# LLM API Keys (Optional if features not used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
